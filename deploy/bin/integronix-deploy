#!/bin/bash
# Pull the image CI published and roll the API onto it.
#   sudo integronix-deploy            # newest main
#   sudo integronix-deploy sha-<commit>   # roll back / pin to a specific build
set -euo pipefail
cd /opt/integronix
export IMAGE_TAG="${1:-main}"

docker compose pull --quiet
docker compose up -d --remove-orphans

echo "waiting for readiness…"
for i in $(seq 1 60); do
  status=$(docker inspect -f '{{.State.Health.Status}}' integronix-api-1 2>/dev/null || echo none)
  if [ "$status" = healthy ]; then
    echo "healthy after $((i * 5))s: $(docker inspect -f '{{.Config.Image}}' integronix-api-1)"
    docker image prune -f >/dev/null
    exit 0
  fi
  sleep 5
done
echo "not healthy after 5 minutes (status: $status)" >&2
docker compose logs --tail 40 api >&2
exit 1
