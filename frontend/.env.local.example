# Integronix Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend API ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Demo Access (FIX FE-BUG-004) ─────────────────────────────────────────────
# Used by the "Demo Access" button on the login page.
# Set up a demo user in Supabase Auth with these credentials.
# Rotate these regularly — they are client-visible (NEXT_PUBLIC_).
NEXT_PUBLIC_DEMO_EMAIL=demo@integronix.ai
NEXT_PUBLIC_DEMO_PASSWORD=IntegronixDemo2025!
