# Integronix Backend — Environment Variables
# Copy this to .env and fill in your values.
# Every key without a default below is REQUIRED — config.py validates at startup.

# ── Supabase ─────────────────────────────────────────────
# REQUIRED. Project URL and keys from Supabase → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional, but needed for anything that bypasses RLS (ingestion, seeds).
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Authentication ───────────────────────────────────────
# Supabase → Project Settings → API → JWT Secret.
# When set, access tokens are verified locally with no network round-trip.
# When blank, the backend falls back to the Supabase Auth API (slower, but
# works with asymmetric signing keys too). Either way tokens ARE verified.
SUPABASE_JWT_SECRET=your-project-jwt-secret

# Master switch for request authentication. Leave true. Setting it false
# issues a synthetic admin principal and is refused when APP_ENV=production.
AUTH_ENABLED=true
# Organization used by that synthetic principal (local development only).
# DEV_ORG_ID=

# Forward the caller's JWT to PostgREST so the RLS policies enforce tenant
# isolation in the database as well as the application.
# Enable ONLY after: (1) migration 020 has run, and (2) every user has signed
# in again to pick up the new app_metadata claim. See 020_jwt_org_claim.sql.
DB_FORWARD_USER_JWT=false

# ── Direct PostgreSQL ────────────────────────────────────
# Used only by scripts/ (generate_embeddings.py, import_snomed_rf2.py),
# which connect via psycopg2 instead of PostgREST.
# Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── Groq LLM ─────────────────────────────────────────────
# REQUIRED.
GROQ_API_KEY=your-groq-api-key
# Optional overrides — defaults live in config.py.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT_SECONDS=15
# GROQ_MAX_RETRIES=1
# GROQ_MAX_TOKENS=2048

# ── SNOMED CT ────────────────────────────────────────────
# Path to the extracted SNOMED CT International RF2 release directory.
# Only needed when running scripts/import_snomed_rf2.py.
SNOMED_RF=/path/to/SnomedCT_InternationalRF2_PRODUCTION_.../Snapshot

# ── WHO ICD API (optional) ───────────────────────────────
# Leave blank to skip the WHO ICD provider; local ICD tables are used instead.
# WHO_ICD_CLIENT_ID=
# WHO_ICD_CLIENT_SECRET=

# ── App Config ───────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
